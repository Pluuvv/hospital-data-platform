    <connection>hospital_dw</connection>
    <sql>SELECT t.name, t.age, t.gender, t.blood_type, t.medical_condition,
       t.date_of_admission, t.doctor, t.hospital, t.insurance_provider,
       t.billing_amount, t.room_number, t.admission_type, t.discharge_date,
       t.medication, t.test_results,
       to_char(t.date_of_admission,'YYYYMMDD')::int AS admission_date_key,
       to_char(t.discharge_date,'YYYYMMDD')::int AS discharge_date_key,
       CASE t.admission_type
         WHEN 'Emergency' THEN 5  + abs(hashtext(t.k)::bigint) % 36
         WHEN 'Urgent'    THEN 15 + abs(hashtext(t.k)::bigint) % 76
         ELSE                  30 + abs(hashtext(t.k)::bigint) % 151
       END AS wait_minutes
FROM (
  SELECT initcap(lower(trim(name))) AS name, age, gender, blood_type, medical_condition,
         date_of_admission, doctor, hospital, insurance_provider, billing_amount,
         room_number, admission_type, discharge_date, medication, test_results,
         initcap(lower(trim(name))) || date_of_admission::text || room_number::text || doctor AS k
  FROM stg.simrs_kunjungan
) t</sql>
